#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

echo "==> Packaging and installing dyamark..."
cd "$ROOT_DIR/pkgbuild"
if command -v go >/dev/null 2>&1 && ! pacman -Q go >/dev/null 2>&1; then
    makepkg -f -d -i --noconfirm "$@"
else
    makepkg -fsi --noconfirm "$@"
fi
