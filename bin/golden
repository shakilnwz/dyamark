#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$ROOT_DIR"

CONFIG_FILE="$(mktemp --suffix=.json)"
trap 'rm -f "$CONFIG_FILE"' EXIT
echo '{"fontFamily": "Liberation Sans"}' > "$CONFIG_FILE"

if [[ "${1:-}" == "--diff" ]]; then
  NAME="${2:-}"
  if [[ -z "$NAME" ]]; then
    echo "Usage: bin/golden --diff <name>" >&2
    exit 1
  fi
  MMD_FILE="seq/testdata/${NAME}.mmd"
  REF_FILE="seq/testdata/${NAME}.ref.svg"
  OUT_FILE="/tmp/${NAME}.out.svg"
  if [[ ! -f "$MMD_FILE" ]]; then
    echo "Error: file $MMD_FILE does not exist" >&2
    exit 1
  fi
  go test -v ./seq/layout -run "TestParity/${NAME}" || true
  exit 0
fi

echo "==> Generating golden reference SVGs with mmdc..."
for f in seq/testdata/*.mmd; do
  [[ -f "$f" ]] || continue
  base="${f%.mmd}"
  ref="${base}.ref.svg"
  echo "Generating $ref..."
  mmdc -i "$f" -o "$ref" -c "$CONFIG_FILE" --no-font-embed -q
done
echo "==> Golden references updated."
