#!/usr/bin/env bash
# Builds dyamark for WebAssembly into build/web/, for the PhpStorm plugin:
# dyamark.wasm, the wasm_exec.js of the same Go, and web/index.html.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
OUT="$ROOT_DIR/build/web"

mkdir -p "$OUT"
cd "$ROOT_DIR"

echo "==> Building build/web/dyamark.wasm..."
# bin/env's tags are for the desktop build; the web build needs none.
GOFLAGS= GOOS=js GOARCH=wasm go build -trimpath -ldflags "-s -w" -o "$OUT/dyamark.wasm" ./cmd/dyamark-web
cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" "$OUT/"
cp "$ROOT_DIR/web/index.html" "$OUT/"

echo "==> Built build/web ($(du -h "$OUT/dyamark.wasm" | cut -f1) wasm)"
