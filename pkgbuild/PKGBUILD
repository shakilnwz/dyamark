# Maintainer: shakilnwz
pkgname=dyamark
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast Markdown viewer and editor with native Mermaid sequence diagrams"
arch=('x86_64')
url="https://github.com/shakilnwz/dyamark"
license=('MIT')
# Gio is built for Wayland + OpenGL ES only (see bin/env): EGL and GLES come
# from libglvnd, the driver from mesa or the vendor's package.
depends=('wayland' 'libxkbcommon' 'libglvnd')
makedepends=('go')
source=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/dyamark "$pkgdir/usr/bin/dyamark"
  install -Dm644 pkgbuild/dyamark.desktop "$pkgdir/usr/share/applications/dyamark.desktop"
  install -Dm644 pkgbuild/dyamark.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dyamark.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 fonts/LICENSE.liberation "$pkgdir/usr/share/licenses/$pkgname/LICENSE.liberation"
}
