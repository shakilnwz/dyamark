<idea-plugin>
  <id>io.github.shakilnwz.dyamark</id>
  <name>dyamark Markdown Preview</name>
  <vendor url="https://github.com/shakilnwz/dyamark">Shakil Nawaz</vendor>
  <description><![CDATA[
    Draws Markdown previews with dyamark: its own Markdown view, and Mermaid
    sequence diagrams laid out like Mermaid's. Pick it under Settings |
    Languages &amp; Frameworks | Markdown | Preview.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.intellij.plugins.markdown</depends>
  <depends>com.intellij.modules.jcef</depends>

  <extensions defaultExtensionNs="org.intellij.markdown">
    <html.panel.provider implementation="dyamark.jetbrains.DyamarkPanelProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="Dyamark" displayType="BALLOON"/>
    <postStartupActivity implementation="dyamark.jetbrains.DyamarkStartupActivity"/>
    <postStartupActivity implementation="dyamark.jetbrains.SpikeStartup"/>
    <postStartupActivity implementation="dyamark.jetbrains.CheckStartup"/>
  </extensions>

  <projectListeners>
    <listener class="dyamark.jetbrains.DyamarkNotificationListener"
              topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    <listener class="dyamark.jetbrains.DyamarkProviderSwitchListener"
              topic="org.intellij.plugins.markdown.settings.MarkdownSettings$ChangeListener"/>
  </projectListeners>

  <applicationListeners>
    <listener class="dyamark.jetbrains.DyamarkEditorColorsListener"
              topic="com.intellij.openapi.editor.colors.EditorColorsListener"/>
    <listener class="dyamark.jetbrains.DyamarkLafListener"
              topic="com.intellij.ide.ui.LafManagerListener"/>
  </applicationListeners>

  <actions>
    <action id="dyamark.zoomIn" class="dyamark.jetbrains.ZoomInAction" text="Zoom In">
      <keyboard-shortcut keymap="$default" first-keystroke="control EQUALS"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control ADD"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control shift EQUALS"/>
    </action>
    <action id="dyamark.zoomOut" class="dyamark.jetbrains.ZoomOutAction" text="Zoom Out">
      <keyboard-shortcut keymap="$default" first-keystroke="control MINUS"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control SUBTRACT"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control shift MINUS"/>
    </action>
    <action id="dyamark.resetZoom" class="dyamark.jetbrains.ResetZoomAction" text="Reset Zoom">
      <keyboard-shortcut keymap="$default" first-keystroke="control 0"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control NUMPAD0"/>
    </action>
  </actions>
</idea-plugin>
